# Copia este archivo a .env y ajusta los valores
PORT=3000
DATABASE_URL=postgres://postgres:TU_CLAVE@localhost:5432/empresa_celulares
# Cadena larga y aleatoria. Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=8h
# Orígenes permitidos para la web (separados por coma). Vacío = cualquiera (solo desarrollo)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
