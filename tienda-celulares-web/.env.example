# Copia este archivo como .env (Windows: copy .env.example .env) y ajusta los valores.

# true  -> usa datos de ejemplo (sin API)
# false -> usa tu API real (debe estar corriendo; por defecto en el puerto 3000)
VITE_USE_MOCK=true

# Ruta base de la API. En desarrollo, vite.config.js redirige /api y /uploads a localhost:3000.
VITE_API_URL=/api

# Solo en producción, si las fotos se sirven desde otro dominio (ej: https://api.mitienda.com).
# Vacío = mismo dominio que la web.
VITE_ASSETS_URL=
